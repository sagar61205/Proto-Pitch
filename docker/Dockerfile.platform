# syntax=docker/dockerfile:1
# The platform itself (API, worker, built web interface). Generated code never runs in
# this image: the worker asks the Docker daemon to start separate sandbox containers.
ARG NODE_IMAGE=node:22-slim
ARG PYTHON_IMAGE=python:3.12-slim
ARG UV_IMAGE=ghcr.io/astral-sh/uv:0.11.32
ARG DOCKER_CLI_IMAGE=docker:29-cli

FROM ${NODE_IMAGE} AS web
WORKDIR /src/frontend
COPY frontend/package.json frontend/package-lock.json ./
RUN npm ci --no-fund --no-audit
COPY frontend/ ./
RUN npm run build

FROM ${UV_IMAGE} AS uv
FROM ${DOCKER_CLI_IMAGE} AS docker-cli

FROM ${PYTHON_IMAGE}
COPY --from=uv /uv /usr/local/bin/uv
COPY --from=docker-cli /usr/local/bin/docker /usr/local/bin/docker
WORKDIR /app
COPY backend/pyproject.toml backend/uv.lock backend/.python-version backend/
RUN cd backend && uv sync --frozen --no-dev --no-install-project
COPY backend/ backend/
RUN cd backend && uv sync --frozen --no-dev
COPY config/ config/
COPY sandbox-images/ sandbox-images/
COPY --from=web /src/frontend/dist frontend/dist
ENV PROTOPITCH_ROOT=/app PATH=/app/backend/.venv/bin:$PATH PYTHONUNBUFFERED=1
EXPOSE 8000
CMD ["protopitch", "serve", "--host", "0.0.0.0"]
